# COGNIVISTA: Cognitive Training Agent Configuration

ENV=development
HOST=0.0.0.0
PORT=8000

# Primary PostgreSQL Database (Automatic fallback to SQLite if PostgreSQL is not active)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cognivista_db
FORCE_SQLITE=false

# Cache (Automatic fallback to high-performance in-memory cache if Redis is not active)
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=cognivista_ultra_secure_jwt_secret_salt_2026_neural_agent
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Optional Google Gemini API key (for creative lateral generation & semantic LLM review)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
